{
  "name": "mont-forge-pipeline",
  "version": "0.2.0",
  "description": "Mont Forge：45 个工程技能 + 9 个开发全流程工具（spec/plan/build/verify/review/ship + assess/catalog/skill）。合并自 addyosmani/agent-skills 与 mattpocock/skills（均 MIT）。",
  "license": "MIT",
  "author": {
    "name": "mont",
    "url": "https://github.com/royrao2007"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royrao2007/mont-forge-pipeline.git"
  },
  "homepage": "https://github.com/royrao2007/mont-forge-pipeline",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "assets",
    "locale/*.json",
    "skills",
    "references",
    "market/index.json",
    "docs",
    "LICENSE",
    "LICENSE-mattpocock",
    "NOTICE.md",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "keywords": [
    "pi-package",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mont-forge",
    "pipeline",
    "sdlc",
    "skill",
    "skills",
    "agent-skills",
    "engineering",
    "ai-agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
